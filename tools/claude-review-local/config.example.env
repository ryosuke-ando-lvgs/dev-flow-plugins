# tools/claude-review-local の設定例。
# コピーして config.env として使う（config.env は .gitignore 対象）。
#   cp config.example.env config.env

# 監視対象リポジトリ（"owner/repo" をスペース区切りで複数指定可）
CLAUDE_REVIEW_REPOS="ryosuke-ando-lvgs/dev-flow-plugins"

# レビュー実行を許可するコメント投稿者（GitHubログイン名、スペース区切り）
CLAUDE_REVIEW_ALLOWED_USERS="ryosuke-ando-lvgs"

# トリガーとなるコメントの先頭文字列
CLAUDE_REVIEW_TRIGGER="/review"

# ポーリング間隔（秒）
CLAUDE_REVIEW_POLL_INTERVAL=90

# リポジトリのローカルクローンを置くディレクトリ
CLAUDE_REVIEW_WORKDIR="$HOME/.claude-review-local/repos"

# state / ログの置き場所
CLAUDE_REVIEW_STATE_DIR="$HOME/.claude-review-local"

# claude コマンドのパス（通常は変更不要）
CLAUDE_REVIEW_CLAUDE_BIN="claude"
